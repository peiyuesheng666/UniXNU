+STATIC
+VOID
+DiagPrint (
+  IN CONST CHAR8  *Text
+  )
+{
+  CHAR16  Buffer[192];
+  UINTN   Index;
+
+  if ((gST == NULL) || (gST->ConOut == NULL)) {
+    return;
+  }
+  for (Index = 0; (Index < 180) && (Text[Index] != '\0'); Index++) {
+    Buffer[Index] = (CHAR16)Text[Index];
+  }
+  Buffer[Index] = L'\0';
+  gST->ConOut->OutputString (gST->ConOut, Buffer);
+  gST->ConOut->OutputString (gST->ConOut, L"\r\n");
+}
+
+STATIC
+VOID
+DiagHex (
+  IN CONST CHAR8  *Label,
+  IN UINT64       Value
+  )
+{
+  CHAR8  Text[72];
+  UINTN  Pos = 0;
+  UINTN  Shift;
+
+  while ((Label[Pos] != '\0') && (Pos < 40)) {
+    Text[Pos] = Label[Pos];
+    Pos++;
+  }
+  Text[Pos++] = '0';
+  Text[Pos++] = 'x';
+  for (Shift = 60; ; Shift -= 4) {
+    UINTN  Digit = (UINTN)((Value >> Shift) & 0xF);
+    Text[Pos++] = (CHAR8)(Digit < 10 ? '0' + Digit : 'a' + Digit - 10);
+    if (Shift == 0) {
+      break;
+    }
+  }
+  Text[Pos] = '\0';
+  DiagPrint (Text);
+}
+
+STATIC
+UINT64
+FatVolumeBytes (
+  IN UINT64  Start
+  )
+{
+  UINT8   *Base = (UINT8 *)(UINTN)Start;
+  UINT16  BytesPerSector;
+  UINT32  TotalSectors;
+
+  BytesPerSector = ReadUnaligned16 ((CONST UINT16 *)(Base + 11));
+  if ((BytesPerSector != 512) && (BytesPerSector != 1024) &&
+      (BytesPerSector != 2048) && (BytesPerSector != 4096))
+  {
+    return 0;
+  }
+
+  TotalSectors = ReadUnaligned16 ((CONST UINT16 *)(Base + 19));
+  if (TotalSectors == 0) {
+    TotalSectors = ReadUnaligned32 ((CONST UINT32 *)(Base + 32));
+  }
+  if (TotalSectors == 0) {
+    return 0;
+  }
+
+  return (UINT64)TotalSectors * (UINT64)BytesPerSector;
+}
