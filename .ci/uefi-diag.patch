+STATIC
+VOID
+DiagPrint (
+  IN CONST CHAR8  *Text
+  )
+{
+  CHAR16  Buffer[192];
+  UINTN   Index;
+
+  if ((gST == NULL) || (gST->ConOut == NULL)) {
+    return;
+  }
+  for (Index = 0; (Index < 180) && (Text[Index] != '\0'); Index++) {
+    Buffer[Index] = (CHAR16)Text[Index];
+  }
+  Buffer[Index] = L'\0';
+  gST->ConOut->OutputString (gST->ConOut, Buffer);
+  gST->ConOut->OutputString (gST->ConOut, L"\r\n");
+}
+
+STATIC
+VOID
+DiagHex (
+  IN CONST CHAR8  *Label,
+  IN UINT64       Value
+  )
+{
+  CHAR8  Text[72];
+  UINTN  Pos = 0;
+  UINTN  Shift;
+
+  while ((Label[Pos] != '\0') && (Pos < 40)) {
+    Text[Pos] = Label[Pos];
+    Pos++;
+  }
+  Text[Pos++] = '0';
+  Text[Pos++] = 'x';
+  for (Shift = 60; ; Shift -= 4) {
+    UINTN  Digit = (UINTN)((Value >> Shift) & 0xF);
+    Text[Pos++] = (CHAR8)(Digit < 10 ? '0' + Digit : 'a' + Digit - 10);
+    if (Shift == 0) {
+      break;
+    }
+  }
+  Text[Pos] = '\0';
+  DiagPrint (Text);
+}
+
+STATIC
+VOID
+DiagProbe (
+  IN UINT64  Address
+  )
+{
+  UINT8        *Probe = (UINT8 *)(UINTN)Address;
+  CHAR8        Text[72];
+  CONST CHAR8  *Label = "SHENGMEM: mem ";
+  UINTN        Pos = 0;
+  UINTN        Index;
+
+  while ((Label[Pos] != '\0') && (Pos < 20)) {
+    Text[Pos] = Label[Pos];
+    Pos++;
+  }
+  for (Index = 0; Index < 8; Index++) {
+    UINTN  Hi = (Probe[Index] >> 4) & 0xF;
+    UINTN  Lo = Probe[Index] & 0xF;
+    Text[Pos++] = (CHAR8)(Hi < 10 ? '0' + Hi : 'a' + Hi - 10);
+    Text[Pos++] = (CHAR8)(Lo < 10 ? '0' + Lo : 'a' + Lo - 10);
+  }
+  Text[Pos] = '\0';
+  DiagPrint (Text);
+}
+
